// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OPERACIONAL
  GERENTE
}

model User {
  id            Int   @id @default(autoincrement())
  name          String
  email         String   @unique
  password_hash String
  role          Role     @default(OPERACIONAL)

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("users")
}

enum Section {
  PENDING
  DOING
  DONE
}
enum OrderStatus {
  WAITING_PRINTING 
  PRINTING
  FINISHED
  PARTIAL_PAYMENT
  FINALIZED_PAYMENT
}

model Order {
  id             Int          @id @default(autoincrement())
  title          String
  tagType        String 
  status         OrderStatus  @default(WAITING_PRINTING)
  archive3d      String       @map("3dArchive") 
  clientId       Int?         @map("ClientID")
  // client        Client?    @relation(fields: [clientId], references: [id]) // model cliente ainda nao existe

  price          Float
  amount_paid    Float        @default(0.0)
  quantity       Int
  payment_method String
  
  cost           Float
  link           String?
  machine        String?
  section        Section      @default(PENDING)

  userId         String       @map("user")
  // user          User       @relation(fields: [userId], references: [id]) // model cliente ainda nao existe

  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
}